{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/bin/sh \"${CURSOR_PLUGIN_ROOT}/bin/ai-review-session-start\"",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "/bin/sh \"${CURSOR_PLUGIN_ROOT}/bin/ai-review-session-start\"",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "/bin/sh \"${CURSOR_PLUGIN_ROOT}/bin/ai-review-pre-edit\"",
        "matcher": "Write|StrReplace|ApplyPatch|Delete|EditNotebook|MultiEdit|Edit",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "/bin/sh \"${CURSOR_PLUGIN_ROOT}/bin/ai-review-pre-edit\"",
        "matcher": "Shell",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "/bin/sh \"${CURSOR_PLUGIN_ROOT}/bin/ai-review-pre-edit\"",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "/bin/sh \"${CURSOR_PLUGIN_ROOT}/bin/ai-review-post-edit\"",
        "matcher": "Write|StrReplace|ApplyPatch|Delete|EditNotebook|MultiEdit|Edit",
        "timeout": 10
      }
    ]
  }
}
